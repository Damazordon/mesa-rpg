; Arquivo de configuração do projeto Godot 4.7 (testado no 4.7.2; também roda no 4.3).

config_version=5

[application]

config/name="Mesa: protótipo visual"
config/description="Interface da mesa de RPG com mestre IA. Dados de exemplo; IA e motor ainda simulados."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/core/game_state.gd"
Master="*res://scripts/core/master_mock.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.063, 0.133, 0.118, 1)
